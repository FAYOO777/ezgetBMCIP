<Window x:Class="EzGetBmcIp.Legacy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ezgetBMCIP"
        Width="620" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status line -->
        <TextBlock Grid.Row="0" Text="{Binding StatusText}" FontSize="16" FontWeight="Bold"
                   Foreground="#0078D4" Margin="0,0,0,8" />

        <!-- Detail text -->
        <TextBlock Grid.Row="1" Text="{Binding DetailText}" FontSize="13"
                   Foreground="#666" Margin="0,0,0,12" TextWrapping="Wrap" />

        <!-- Adapter / Main controls -->
        <StackPanel Grid.Row="2" Visibility="{Binding ShowAdapterSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="网卡:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapterItem}"
                          DisplayMemberPath="DisplayName" Width="320" Height="28" />
                <Button Content="开始" Command="{Binding StartCommand}" IsEnabled="{Binding StartButtonEnabled}"
                        Width="60" Height="28" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <TextBlock Text="网段: " VerticalAlignment="Center" FontSize="13" />
                <TextBox Text="{Binding SubnetConfig.Octet1Text, UpdateSourceTrigger=LostFocus}"
                         Width="36" TextAlignment="Center" MaxLength="3" />
                <TextBlock Text="." VerticalAlignment="Center" />
                <TextBox Text="{Binding SubnetConfig.Octet2Text, UpdateSourceTrigger=LostFocus}"
                         Width="36" TextAlignment="Center" MaxLength="3" />
                <TextBlock Text="." VerticalAlignment="Center" />
                <TextBox Text="{Binding SubnetConfig.Octet3Text, UpdateSourceTrigger=LostFocus}"
                         Width="36" TextAlignment="Center" MaxLength="3" />
                <TextBlock Text="." VerticalAlignment="Center" />
                <TextBox Text="{Binding SubnetConfig.Octet4Text, UpdateSourceTrigger=LostFocus}"
                         Width="36" TextAlignment="Center" MaxLength="3" />
                <TextBlock Text=" /24" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                <TextBlock Text="(BMC: .100)" VerticalAlignment="Center" FontSize="12" Foreground="#888" />
            </StackPanel>
            <TextBlock Text="仅支持私有网段：10.x.x.x / 172.16-31.x.x / 192.168.x.x"
                       FontSize="12" Foreground="#888" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Running state -->
        <StackPanel Grid.Row="2" Visibility="{Binding ShowRunning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding AdapterCardLine}" FontSize="13" FontWeight="Bold"
                       Margin="0,0,0,4" />
            <TextBlock Text="{Binding ActivityText}" FontSize="12" Foreground="#555"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="Bold"
                       Foreground="{Binding BadgeColor}" />
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Width="60" Height="26" Margin="0,8,0,0" />
        </StackPanel>

        <!-- IP result -->
        <StackPanel Grid.Row="3" Visibility="{Binding ShowIpResult, Converter={StaticResource BoolToVis}}"
                    Margin="0,8,0,0">
            <TextBlock Text="BMC 地址:" FontSize="13" Foreground="#0078D4" Margin="0,0,0,4" />
            <TextBlock Text="{Binding DiscoveredIp}" FontSize="22" FontWeight="Bold"
                       FontFamily="Consolas" Margin="0,0,0,8" />
            <Button Content="打开 BMC" Click="OpenBmcButton_Click" Width="80" Height="28" />
        </StackPanel>

        <!-- Spacer -->
        <Grid Grid.Row="4" />

        <!-- Bottom row -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="日志" Click="OpenLog_Click"
                    Width="60" Height="32" Margin="0,0,10,0" />
            <Button Content="退出并恢复网卡" Command="{Binding ExitCommand}"
                    Width="130" Height="32" />
        </StackPanel>
    </Grid>
</Window>
