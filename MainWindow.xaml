<ui:FluentWindow x:Class="EzGetBmcIp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:EzGetBmcIp"
        Title="IPMI/BMC 直连助手"
        Width="700" Height="660" MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <ui:FluentWindow.Resources>
        <local:SessionPageKindToVisibilityConverter x:Key="PageToVis" />
        <local:PresentationSeverityToBrushConverter x:Key="SeverityToBrush" />
        <local:ModernStageStateToBrushConverter x:Key="ModernStageBrush" />
        <local:ModernActionToVisibilityConverter x:Key="ModernActionToVis" />
        <SolidColorBrush x:Key="PreflightScrimBrush" Color="#66000000" />
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Title Bar ═══════════════ -->
        <ui:TitleBar Grid.Row="0"
                     Title="IPMI/BMC 直连助手">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource AppIconDrawing}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ═══════════════ Content ═══════════════ -->
        <ScrollViewer x:Name="ContentScroller"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,22,32,22">
                <!-- Compatibility container for the pre-modern terminal cards. It is
                     hidden as soon as the unified formal runtime host is active. -->
                <StackPanel x:Name="LegacySessionPages"
                            Visibility="{Binding ShowLegacySessionPages, Converter={StaticResource BoolToVis}}">
                <!-- ── Terminal result pages: selected only by CurrentSessionPage ── -->
                <Border x:Name="RestoreFailedPage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        BorderBrush="{StaticResource BrandCriticalBrush}" BorderThickness="1"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=RestoreFailed}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource BrandCriticalBrush}" Margin="0,0,0,8" />
                        <TextBlock FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14">
                            <Run Text="工具无法确认“" />
                            <Run Text="{Binding RecoveryAdapterDisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="”已恢复到使用前配置。" />
                        </TextBlock>

                        <Border Background="#FDF2F2" BorderBrush="#E7B2B0" BorderThickness="1"
                                CornerRadius="6" Padding="14,11" Margin="0,0,0,16">
                            <TextBlock Text="该网卡可能仍在临时配置下，原有网络连接可能尚未恢复。"
                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrandCriticalBrush}" />
                        </Border>

                        <ui:Button Content="导出支持包"
                                   Click="CollectSupportBundle_Click"
                                   Appearance="Secondary"
                                   Height="40" Padding="18,0" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding RecoveryOriginalConfigDetails}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,10" />
                    </StackPanel>
                </Border>

                <Border x:Name="EndpointReachablePage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        BorderBrush="{StaticResource BrandSuccessBrush}" BorderThickness="1"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=EndpointReachable}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource BrandSuccessBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16" />

                        <Border Background="#F4FAF6" BorderBrush="#B8D8C2" BorderThickness="1"
                                CornerRadius="6" Padding="16,13" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="{Binding DiscoveredIpUrl}" FontSize="24" FontWeight="Bold"
                                           FontFamily="Consolas, Courier New" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrandPrimaryBrush}" />
                                <TextBlock Margin="0,10,0,0" FontSize="13"
                                           Foreground="#1F2937">
                                    <Run Text="IP：" />
                                    <Run Text="{Binding DiscoveredIp, Mode=OneWay}" FontFamily="Consolas, Courier New" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontSize="13"
                                           Foreground="#1F2937">
                                     <Run Text="TCP 端口：" />
                                    <Run Text="{Binding EndpointProtocolPortText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding EndpointVerificationText}" Margin="0,4,0,0" FontSize="13"
                                           Foreground="#4B5563" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CandidateSourceText}" Margin="0,4,0,0" FontSize="13"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,0,0,14">
                            <ui:Button Content="打开管理页面"
                                       Command="{Binding OpenManagementPageCommand}"
                                       Style="{StaticResource BrandPrimaryButtonStyle}"
                                       Height="40" Padding="18,0" Margin="0,0,10,8" />
                            <ui:Button Content="{Binding CopyButtonText}"
                                       Command="{Binding CopyIpCommand}"
                                       Appearance="Secondary"
                                       Height="40" Padding="16,0" Margin="0,0,10,8" />
                        </WrapPanel>

                        <TextBlock Text="{Binding BrowserStatusText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{Binding BrowserStatusSeverity, Converter={StaticResource SeverityToBrush}}"
                                   Margin="0,0,0,14"
                                   Visibility="{Binding ShowBrowserStatus, Converter={StaticResource BoolToVis}}" />

                        <Border Background="#FFF7E6" BorderBrush="#E4C07A" BorderThickness="1"
                                CornerRadius="6" Padding="13,10" Margin="0,0,0,14"
                                Visibility="{Binding HasEndpointNetworkWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding EndpointNetworkWarning}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="#4A3410" />
                        </Border>

                        <Border Background="#FFF7E6" BorderBrush="#E4C07A" BorderThickness="1"
                                CornerRadius="6" Padding="13,10">
                            <TextBlock Text="完成浏览器中的管理操作前，请不要恢复网卡。恢复原配置后，当前管理地址可能无法继续从本机访问。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="#4A3410" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="EndpointUnreachablePage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        BorderBrush="#D9A441" BorderThickness="1"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=EndpointUnreachable}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="#8A5A00" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16" />

                        <Border Background="#FFF9EB" BorderBrush="#E4C07A" BorderThickness="1"
                                CornerRadius="6" Padding="16,13" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding DiscoveredIp}" FontSize="25" FontWeight="Bold"
                                           FontFamily="Consolas, Courier New"
                                           Foreground="#1F2937" />
                                <TextBlock Text="{Binding CandidateSourceText}" Margin="0,7,0,0" FontSize="13"
                                           Foreground="#4B5563" />
                                <TextBlock Text="{Binding EndpointVerificationText}" Margin="0,7,0,0" FontSize="13"
                                           Foreground="#8A5A00" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,0,0,12">
                            <ui:Button Content="重新检测" Command="{Binding RetryEndpointCommand}"
                                       Style="{StaticResource BrandPrimaryButtonStyle}"
                                       Height="40" Padding="18,0" Margin="0,0,10,8" />
                            <ui:Button Content="{Binding CopyButtonText}" Command="{Binding CopyIpCommand}"
                                       Appearance="Secondary" Height="40" Padding="16,0" Margin="0,0,10,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── Waiting / failure / recovery pages: selected only by CurrentSessionPage ── -->
                <Border x:Name="WaitingForLinkPage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=WaitingForLink}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="6" Padding="15,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="所选网卡：" />
                                    <Run Text="{Binding CurrentAdapterName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold"
                                           Text="{Binding LinkStatusText}"
                                           Foreground="{StaticResource BrandPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="请将此网卡连接到服务器的独立管理口。检测到物理连接后将自动继续。"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Background="#FFF9EB" BorderBrush="#E4C07A" BorderThickness="1"
                                CornerRadius="6" Padding="13,10" Margin="0,14,0,0"
                                Visibility="{Binding ShowLongLinkWaitHint, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="仍未检测到连接，请确认网线和管理口连接正常。"
                                       FontSize="12" TextWrapping="Wrap" Foreground="#4A3410" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="WaitingForDhcpPage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=WaitingForDhcp}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16" />

                        <Border Background="#F3F7FB" BorderBrush="#B7CBE0" BorderThickness="1"
                                CornerRadius="6" Padding="16,13" Margin="0,0,0,13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Text="本机临时地址" FontSize="12"
                                           Foreground="#4B5563" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubnetConfig.ServerDisplay, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                           Foreground="#1F2937" />
                                <TextBlock Grid.Row="1" Text="预期候选地址" FontSize="12" Margin="0,7,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubnetConfig.PoolDisplay, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                           Margin="18,7,0,0" Foreground="#1F2937" />
                                <TextBlock Grid.Row="2" Text="已等待" FontSize="12" Margin="0,7,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DhcpElapsedText}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                           Margin="18,7,0,0" Foreground="#1F2937" />
                                <TextBlock Grid.Row="3" Text="最长等待" FontSize="12" Margin="0,7,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DhcpMaximumWaitText}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                           Margin="18,7,0,0" Foreground="#1F2937" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding DhcpEvidenceText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{Binding DhcpEvidenceSeverity, Converter={StaticResource SeverityToBrush}}"
                                   Margin="0,0,0,12" />

                        <Border Background="#FFF9EB" BorderBrush="#E4C07A" BorderThickness="1"
                                CornerRadius="6" Padding="13,10" Margin="0,0,0,10"
                                Visibility="{Binding ShowLongDhcpWaitHint, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="等待时间较长。" FontSize="12" FontWeight="SemiBold" Foreground="#4A3410" />
                                <TextBlock Text="• 网线连接的是服务器独立管理口&#x0a;• 管理口当前启用了 DHCP / 自动获取地址"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#4A3410" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{Binding FirewallSeverity, Converter={StaticResource SeverityToBrush}}"
                                BorderThickness="1" CornerRadius="6" Padding="13,10"
                                Visibility="{Binding ShowDhcpFirewallEvidence, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FirewallSummary}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding FirewallSeverity, Converter={StaticResource SeverityToBrush}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="ProbingEndpointPage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=ProbingEndpoint}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16" />

                        <Border Background="#F3F7FB" BorderBrush="#B7CBE0" BorderThickness="1"
                                CornerRadius="6" Padding="16,13" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="候选管理地址" FontSize="12" Foreground="#4B5563" />
                                <TextBlock Text="{Binding DiscoveredIp}" FontSize="25" FontWeight="Bold"
                                           FontFamily="Consolas, Courier New" Foreground="#1F2937" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding CandidateSourceText}" FontSize="12" Foreground="#4B5563" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="正在检查：Ping    TCP · 443    TCP · 80"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" />
                        <TextBlock Text="已取得候选地址，正在确认地址可达性。"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="DhcpTimedOutPage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        BorderBrush="#D9A441" BorderThickness="1"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=DhcpTimedOut}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="#8A5A00" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16" />

                        <Border Background="#FFF9EB" BorderBrush="#E4C07A" BorderThickness="1"
                                CornerRadius="6" Padding="14,12" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="#4A3410">
                                    <Run Text="当前网卡：" /><Run Text="{Binding CurrentAdapterName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,6,0,0" Foreground="#4A3410">
                                    <Run Text="临时本机地址：" /><Run Text="{Binding SubnetConfig.ServerDisplay, Mode=OneWay}" FontFamily="Consolas, Courier New" />
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,6,0,0" Foreground="#4A3410">
                                    <Run Text="等待时间：" /><Run Text="{Binding DhcpElapsedText, Mode=OneWay}" FontFamily="Consolas, Courier New" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{Binding FirewallSeverity, Converter={StaticResource SeverityToBrush}}"
                                BorderThickness="1" CornerRadius="6" Padding="13,10" Margin="0,0,0,12"
                                Visibility="{Binding HasFirewallAssessment, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FirewallSummary}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{Binding FirewallSeverity, Converter={StaticResource SeverityToBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding DhcpTimeoutFollowUpText}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding HasDhcpTimeoutFollowUp, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="检查当前连接与管理口网络设置；无需在此页再次等待 3 分钟。"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <WrapPanel Margin="0,0,0,10">
                            <ui:Button Content="导出支持包" Click="CollectSupportBundle_Click"
                                       Style="{StaticResource BrandPrimaryButtonStyle}"
                                       Height="40" Padding="18,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="FailurePage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        BorderBrush="{StaticResource BrandCriticalBrush}" BorderThickness="1"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=Failure}">
                    <StackPanel>
                        <TextBlock Text="{Binding FailureTitle}" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource BrandCriticalBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding FailureSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14" />

                        <Border Background="#FDF2F2" BorderBrush="#E7B2B0" BorderThickness="1"
                                CornerRadius="6" Padding="13,10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding FailureNetworkImpactText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrandCriticalBrush}" />
                        </Border>
                        <TextBlock Text="推荐下一步" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding FailureRecommendedActionText}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,4,0,14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <WrapPanel Margin="0,0,0,10">
                             <ui:Button Content="重新检测地址" Command="{Binding RetryEndpointCommand}"
                                       Style="{StaticResource BrandPrimaryButtonStyle}"
                                       Height="40" Padding="18,0" Margin="0,0,10,8"
                                       Visibility="{Binding CanRetryEndpointFromFailure, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Content="导出支持包" Click="CollectSupportBundle_Click"
                                       Appearance="Secondary" Height="40" Padding="18,0" Margin="0,0,10,8" />
                        </WrapPanel>

                    </StackPanel>
                </Border>

                <Border x:Name="CancelledPage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=Cancelled}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="RestoringPage" Style="{StaticResource CardBorderStyle}" Padding="26,22"
                        Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=Restoring}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,7" />
                        <TextBlock FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="正在恢复“" /><Run Text="{Binding RecoveryAdapterDisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="”使用工具前的网络配置。请等待完成。" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- ── Preparation card ── -->
                <StackPanel Visibility="{Binding ShowPreparationContent, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding DetailText}" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="使用前确认" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,10" />
                                <TextBlock FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"
                                           Text="1. 笔记本有线网卡直连服务器 IPMI/BMC 管理口。" />
                                <TextBlock FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"
                                           Text="2. 此工具会临时修改所选网卡；退出时仅恢复本机网卡，不会还原 BMC 网络设置。" />
                                <TextBlock FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="3. 仅适用于直连场景，不适合在已有局域网内使用。" />
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Content="下一步"
                                       Command="{Binding GoNextCommand}"
                                       Style="{StaticResource BrandPrimaryButtonStyle}"
                                       MinWidth="132" Height="40"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Hero card (AdapterSelection + FlowRunning) ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18"
                        Visibility="{Binding ShowRuntimeHero, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DetailText}" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ── Adapter selector card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18,16"
                        Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="连接 BMC 的网卡"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}" />
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="当前网卡"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=FlowRunning}" />

                        <!-- ── Default state: before flow starts ── -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="选择网卡"
                                   VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,14,0"
                                   Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}" />

                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapterItem}"
                                  IsEnabled="{Binding AdapterSelectionEnabled}"
                                  Height="38" VerticalAlignment="Center"
                                  Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ui:Button Grid.Row="1" Grid.Column="2"
                                Content="开始"
                                Command="{Binding StartCommand}"
                                Style="{StaticResource BrandPrimaryButtonStyle}"
                                IsEnabled="{Binding StartButtonEnabled}"
                                MinWidth="96" Height="38" Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}" />

                        <Border Grid.Row="2" Grid.ColumnSpan="3"
                                Margin="0,12,0,0"
                                Padding="12,9"
                                CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{Binding AdapterFirewallNoticeSeverity, Converter={StaticResource SeverityToBrush}}"
                                BorderThickness="1"
                                Visibility="{Binding ShowAdapterFirewallNotice, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Margin="0,4,10,0"
                                         VerticalAlignment="Top"
                                         Fill="{Binding AdapterFirewallNoticeSeverity, Converter={StaticResource SeverityToBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding AdapterFirewallNoticeTitle}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding AdapterFirewallNoticeSeverity, Converter={StaticResource SeverityToBrush}}" />
                                    <TextBlock Text="{Binding FirewallRepairFeedback}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,3,12,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:Button Grid.Column="2"
                                           Content="重新处理"
                                           Command="{Binding RepairFirewallCommand}"
                                           IsEnabled="{Binding FirewallRepairEnabled}"
                                           Appearance="Secondary"
                                           MinWidth="88" Height="32"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding ShowAdapterFirewallRetry, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <!-- ── Running state: after flow starts ── -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                                    Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=FlowRunning}"
                                    Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource BrandSuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding AdapterCardLine1}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding AdapterCardLine1}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Subnet config card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18,14"
                        Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="高级设置：临时修改本机网卡 IPv4" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrandPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="下方 IP 会临时设置到所选网卡；BMC 不会被主动修改。"/>
                                    <LineBreak />
                                    <Run Text="BMC 经 DHCP 请求时，预期获得 "/>
                                    <Run Text="{Binding SubnetConfig.PoolDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="。"/>
                                </TextBlock>
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Content="{Binding AdvancedSubnetToggleText}"
                                       Command="{Binding ToggleAdvancedSubnetCommand}"
                                       Appearance="Secondary"
                                       MinWidth="72" Height="32"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                        </Grid>

                        <!-- Temporary IPv4 address for the selected local adapter -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsAdvancedSubnetExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="本机网卡临时 IPv4 地址"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SubnetConfig.Octet1Text, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="3" TextAlignment="Center"
                                     FontSize="18" FontWeight="SemiBold"
                                     Height="40" VerticalContentAlignment="Center"
                                     Style="{StaticResource SubnetOctetTextBoxStyle}"
                                     PreviewTextInput="OctetTextBox_PreviewTextInput" />
                            <TextBlock Grid.Column="1" Text="." FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding SubnetConfig.Octet2Text, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="3" TextAlignment="Center"
                                     FontSize="18" FontWeight="SemiBold"
                                     Height="40" VerticalContentAlignment="Center"
                                     Style="{StaticResource SubnetOctetTextBoxStyle}"
                                     PreviewTextInput="OctetTextBox_PreviewTextInput" />
                            <TextBlock Grid.Column="3" Text="." FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="4" Text="{Binding SubnetConfig.Octet3Text, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="3" TextAlignment="Center"
                                     FontSize="18" FontWeight="SemiBold"
                                     Height="40" VerticalContentAlignment="Center"
                                     Style="{StaticResource SubnetOctetTextBoxStyle}"
                                     PreviewTextInput="OctetTextBox_PreviewTextInput" />
                            <TextBlock Grid.Column="5" Text="." FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBox Grid.Column="6" Text="{Binding SubnetConfig.Octet4Text, UpdateSourceTrigger=LostFocus}"
                                         MaxLength="3" TextAlignment="Center"
                                         FontSize="18" FontWeight="SemiBold"
                                         Height="40" VerticalContentAlignment="Center"
                                         Style="{StaticResource SubnetOctetTextBoxStyle}"
                                         PreviewTextInput="OctetTextBox_PreviewTextInput" />
                            </Grid>
                        </StackPanel>

                        <!-- Info -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsAdvancedSubnetExpanded, Converter={StaticResource BoolToVis}}">
                            <Run Text="子网掩码: 255.255.255.0"/>
                            <Run Text="  ·  "/>
                            <Run Text="BMC 经 DHCP 预期地址: "/>
                            <Run Text="{Binding SubnetConfig.PoolDisplay, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="仅支持私有网段：10.x.x.x / 172.16-31.x.x / 192.168.x.x"
                                   Visibility="{Binding IsAdvancedSubnetExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- ── Unified formal runtime surface ── -->
                <Border x:Name="ModernRuntimeHost"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="0"
                        Visibility="{Binding ShowModernRuntimeHost, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- A light navigation guide: it describes the discovery goal,
                             while restoration remains the fixed safety action below. -->
                        <Border x:Name="ModernStageRail"
                                Padding="20,14"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Visibility="{Binding ModernRuntime.ShowStageRail, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ModernRuntime.Stages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                                         Fill="{Binding State, Converter={StaticResource ModernStageBrush}}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StateText}" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"
                                                       Foreground="{Binding State, Converter={StaticResource ModernStageBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border x:Name="ModernSessionCard"
                                Padding="24,22"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21"
                                            Background="{Binding ModernRuntime.Severity, Converter={StaticResource SeverityToBrush}}"
                                            VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding ModernRuntime.StatusGlyph}"
                                                   Foreground="White" FontSize="22" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ModernRuntime.Title}" FontSize="23"
                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                   Foreground="{Binding ModernRuntime.Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding ModernRuntime.Summary}" FontSize="14"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,18,0,0" Padding="14,11"
                                        CornerRadius="6"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding ModernRuntime.HasPrimaryValue, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ModernRuntime.PrimaryValueLabel}"
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,18,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding ModernRuntime.PrimaryValue}"
                                                   FontSize="18" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Border>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding ModernRuntime.ShowProgressRing, Converter={StaticResource BoolToVis}}">
                                    <ui:ProgressRing Width="28" Height="28" IsIndeterminate="True"
                                                     Foreground="{StaticResource BrandPrimaryBrush}"
                                                     HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding ModernRuntime.ProgressText}" FontSize="13"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding ModernRuntime.Facts}" Margin="0,16,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,18,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{Binding ModernRuntime.NoticeSeverity, Converter={StaticResource SeverityToBrush}}"
                                        BorderThickness="1"
                                        Visibility="{Binding ModernRuntime.HasNotice, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ModernRuntime.NoticeText}" FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding ModernRuntime.NoticeSeverity, Converter={StaticResource SeverityToBrush}}" />
                                </Border>

                                <WrapPanel Margin="0,16,0,0">
                                    <ui:Button Content="打开管理页面" Command="{Binding OpenManagementPageCommand}"
                                               Style="{StaticResource BrandPrimaryButtonStyle}"
                                               Height="40" Padding="18,0" Margin="0,0,10,8"
                                               Visibility="{Binding ModernRuntime.PrimaryAction, Converter={StaticResource ModernActionToVis}, ConverterParameter=OpenManagementPage}" />
                                    <ui:Button Content="重新检测" Command="{Binding RetryEndpointCommand}"
                                               Style="{StaticResource BrandPrimaryButtonStyle}"
                                               Height="40" Padding="18,0" Margin="0,0,10,8"
                                               Visibility="{Binding ModernRuntime.PrimaryAction, Converter={StaticResource ModernActionToVis}, ConverterParameter=RetryEndpoint}" />
                                    <ui:Button Content="使用上次网段重试" Command="{Binding PrepareHistoryRetryCommand}"
                                               Style="{StaticResource BrandPrimaryButtonStyle}"
                                               Height="40" Padding="18,0" Margin="0,0,10,8"
                                               Visibility="{Binding ModernRuntime.PrimaryAction, Converter={StaticResource ModernActionToVis}, ConverterParameter=PrepareHistoryRetry}" />
                                    <ui:Button Content="处理防火墙并准备重试" Command="{Binding RepairFirewallCommand}"
                                               Style="{StaticResource BrandPrimaryButtonStyle}"
                                               Height="40" Padding="18,0" Margin="0,0,10,8"
                                               IsEnabled="{Binding FirewallRepairEnabled}"
                                               Visibility="{Binding ModernRuntime.PrimaryAction, Converter={StaticResource ModernActionToVis}, ConverterParameter=RepairFirewall}" />
                                    <ui:Button Content="导出支持包" Click="CollectSupportBundle_Click"
                                               Style="{StaticResource BrandPrimaryButtonStyle}"
                                               Height="40" Padding="18,0" Margin="0,0,10,8"
                                               Visibility="{Binding ModernRuntime.PrimaryAction, Converter={StaticResource ModernActionToVis}, ConverterParameter=ExportSupport}" />
                                    <ui:Button Content="导出支持包" Click="CollectSupportBundle_Click"
                                               Appearance="Secondary" Height="40" Padding="18,0" Margin="0,0,10,8"
                                               Visibility="{Binding ModernRuntime.SecondaryAction, Converter={StaticResource ModernActionToVis}, ConverterParameter=ExportSupport}" />
                                    <ui:Button Content="复制地址" Command="{Binding CopyIpCommand}"
                                               Appearance="Secondary" Height="40" Padding="16,0" Margin="0,0,10,8"
                                               Visibility="{Binding ModernRuntime.SecondaryAction, Converter={StaticResource ModernActionToVis}, ConverterParameter=CopyAddress}" />
                                </WrapPanel>

                                <Expander Header="其他方式" FontSize="12" Margin="0,2,0,0"
                                          Visibility="{Binding ModernRuntime.ShowOtherEndpointActions, Converter={StaticResource BoolToVis}}">
                                    <WrapPanel Margin="0,8,0,0">
                                        <ui:Button Content="尝试 HTTPS" Command="{Binding OpenHttpsCommand}"
                                                   Appearance="Secondary" Height="36" Padding="14,0" Margin="0,0,8,8"
                                                   Visibility="{Binding ModernRuntime.ShowHttpsFallbackAction, Converter={StaticResource BoolToVis}}" />
                                        <ui:Button Content="改用 HTTP" Command="{Binding OpenHttpCommand}"
                                                   Appearance="Secondary" Height="36" Padding="14,0" Margin="0,0,8,8"
                                                   Visibility="{Binding ModernRuntime.ShowHttpFallbackAction, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>
                                </Expander>

                                <TextBlock Text="{Binding BrowserStatusText}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Foreground="{Binding BrowserStatusSeverity, Converter={StaticResource SeverityToBrush}}"
                                           Visibility="{Binding ShowBrowserStatus, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding FailureRecommendedActionText}" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Visibility="{Binding CurrentSessionPage, Converter={StaticResource PageToVis}, ConverterParameter=Failure}" />

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Retired runtime card retained only as a non-rendering compatibility
                     surface for old bindings and test seams. ── -->
                <!-- ── Current step card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="28,20"
                        Visibility="{Binding ShowLegacyRuntimeProgress, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Icon -->
                                    <Grid Width="52" Height="52" HorizontalAlignment="Center"
                                          Margin="0,0,0,10">
                                        <Ellipse x:Name="BadgeCircle"
                                                 Width="52" Height="52"
                                                 Fill="Transparent"
                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="3" />
                                        <Path x:Name="BadgeCheck"
                                              Data="M15,28 L25,38 L42,18"
                                              Stroke="White" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <Path x:Name="BadgeCross"
                                              Data="M17,17 L39,39 M39,17 L17,39"
                                              Stroke="White" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                    </Grid>

                                    <TextBlock x:Name="BadgeTitle"
                                               Text="{Binding CurrentStep.Title}"
                                               FontSize="19" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Text="{Binding ActivityText}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,0,0,10" MaxWidth="440"
                                               TextWrapping="Wrap" />

                                    <Border x:Name="BadgeBorder"
                                            CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDisabledBrush}">
                                        <TextBlock x:Name="BadgeTextBlock"
                                                   Text="{Binding BadgeText}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="{Binding CurrentStep.Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,10,0,0" MaxWidth="440"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource BrandSuccessBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeCheck" Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="BadgeTitle" Property="Foreground"
                                                Value="{StaticResource BrandSuccessBrush}" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource BrandSuccessBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Active}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource BrandPrimaryBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource BrandPrimaryBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Failed}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource BrandCriticalBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeCross" Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="BadgeTitle" Property="Foreground"
                                                Value="{StaticResource BrandCriticalBrush}" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource BrandCriticalBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <!-- ── Previous BMC subnet suggestion after first DHCP timeout ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18"
                        BorderBrush="#D9A441" BorderThickness="1"
                        Visibility="{Binding ShowLegacyRuntimeProgress, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionPageTitle}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#8A5A00" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding SessionPageSummary}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding HistoryRetrySuggestionText}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="这不是当前连接设备身份的证明，也不表示该历史地址仍然可用。"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Background="#FFF9EB" BorderBrush="#E4C07A" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="#4A3410"><Run Text="本机网卡：" /><Run Text="{Binding HistoryAdapterName, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12" Foreground="#4A3410" Margin="0,5,0,0"><Run Text="上次临时地址：" /><Run Text="{Binding HistoryLocalAddress, Mode=OneWay}" FontFamily="Consolas, Courier New" /></TextBlock>
                                <TextBlock FontSize="12" Foreground="#4A3410" Margin="0,5,0,0"><Run Text="当时管理地址：" /><Run Text="{Binding HistoryBmcAddress, Mode=OneWay}" FontFamily="Consolas, Courier New" /></TextBlock>
                                <TextBlock FontSize="12" Foreground="#4A3410" Margin="0,5,0,0"><Run Text="上次可达性：" /><Run Text="{Binding HistoryEndpointText, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12" Foreground="#4A3410" Margin="0,5,0,0"><Run Text="确认时间：" /><Run Text="{Binding HistoryLastConfirmedText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="使用上次网段重试"
                                       Command="{Binding PrepareHistoryRetryCommand}"
                                       Style="{StaticResource BrandPrimaryButtonStyle}"
                                       Height="36" Padding="16,0" />
                            <ui:Button Content="导出支持包"
                                       Click="CollectSupportBundle_Click"
                                       Appearance="Secondary"
                                       Height="36" Padding="16,0" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Support action for failures without a history retry ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18"
                        Visibility="{Binding ShowLegacySupportBundleCard, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="430">
                            <TextBlock Text="请收集支持包" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandCriticalBrush}" Margin="0,0,0,5" />
                            <TextBlock Text="支持包会收集本次诊断与应用日志，便于判断 DHCP、网卡和防火墙状态。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button Content="导出支持包" Click="CollectSupportBundle_Click"
                                   Appearance="Secondary" Height="36" MinWidth="112"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- ── Step indicator ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="32,16"
                        Visibility="{Binding ShowLegacyRuntimeProgress, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="20" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left connector line -->
                                    <Rectangle x:Name="LeftLine"
                                               Grid.Row="0" Grid.Column="0"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisInv}}" />

                                    <!-- Right connector line -->
                                    <Rectangle x:Name="RightLine"
                                               Grid.Row="0" Grid.Column="2"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsLast, Converter={StaticResource BoolToVisInv}}" />

                                    <!-- Circle + check / cross -->
                                    <Grid Grid.Row="0" Grid.Column="1"
                                          Width="20" Height="20">
                                        <Ellipse x:Name="StepCircle"
                                                 Width="20" Height="20"
                                                 Fill="Transparent"
                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="2" />
                                        <!-- Checkmark -->
                                        <Path x:Name="StepCheck"
                                              Data="M5,10 L8,13 L15,6"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <!-- Cross -->
                                        <Path x:Name="StepCross"
                                              Data="M6,6 L14,14 M14,6 L6,14"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                    </Grid>

                                    <!-- Label -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding ShortTitle}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <!-- ═══ Step DataTriggers ═══ -->
                                <DataTemplate.Triggers>
                                    <!-- Done -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource BrandSuccessBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="StepCheck"
                                                Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="RightLine"
                                                Property="Fill"
                                                Value="{StaticResource BrandSuccessBrush}" />
                                    </DataTrigger>
                                    <!-- Active -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Active}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource BrandPrimaryBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                    </DataTrigger>
                                    <!-- Failed -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Failed}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource BrandCriticalBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="StepCross"
                                                Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>

                                    <!-- Left line turns green when previous step is Done -->
                                    <DataTrigger Binding="{Binding PreviousState}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="LeftLine"
                                                Property="Fill"
                                                Value="{StaticResource BrandSuccessBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- A preflight overlay covers only the main content. The footer,
             including the safe exit action, remains available while the
             read-only checks are running. -->
        <Border x:Name="StartPreflightOverlay"
                Grid.Row="1"
                Panel.ZIndex="20"
                Background="{StaticResource PreflightScrimBrush}"
                Visibility="{Binding ShowStartPreflightOverlay, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Border x:Name="StartPreflightCard"
                        Width="360"
                        Padding="28,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <ui:ProgressRing Width="38"
                                         Height="38"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource BrandPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,16" />
                        <TextBlock Text="{Binding StartPreflightTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StartPreflightStageText}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,9,0,6" />
                        <TextBlock Text="{Binding StartPreflightDetailText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════ Footer ═══════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid Height="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{Binding NetworkStatusSeverity, Converter={StaticResource SeverityToBrush}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="本机网卡状态" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ModernNetworkStatusText}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding NetworkStatusSeverity, Converter={StaticResource SeverityToBrush}}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ui:Button Content="{Binding ExitButtonText}"
                               Command="{Binding ExitCommand}"
                               IsEnabled="{Binding IsExitActionEnabled}"
                               Appearance="Secondary"
                               MinWidth="142" Height="40" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SupportProgressCard"
                Grid.RowSpan="3"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="24,0,24,72"
                Padding="16,12"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="SupportProgressTitle"
                               Text="正在收集日志和诊断"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrandPrimaryBrush}" />
                    <TextBlock x:Name="SupportProgressPercent"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="0%" />
                </Grid>
                <TextBlock x:Name="SupportProgressDetail"
                           Grid.Row="1"
                           Margin="0,5,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="正在准备支持包..."
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="SupportProgressBar"
                             Grid.Row="2"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="6"
                             Foreground="{StaticResource BrandPrimaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
