<ui:FluentWindow x:Class="EzGetBmcIp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:EzGetBmcIp"
        Title="ezgetBMCIP"
        Width="840" Height="750" MinWidth="760" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Title Bar ═══════════════ -->
        <ui:TitleBar Grid.Row="0"
                     Title="ezgetBMCIP — 获取BMC的IP，应该可以变得更简单">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource AppIconDrawing}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ═══════════════ Content ═══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,24">

                <!-- ── Hero card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DetailText}" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ── Adapter selector card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="目标网卡"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Margin="0,0,0,8" />

                        <!-- ── Default state: before flow starts ── -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="选择网卡"
                                   VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,14,0"
                                   Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}" />

                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapterItem}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding AdapterSelectionEnabled}"
                                  Height="38" VerticalAlignment="Center"
                                  Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}" />

                        <ui:Button Grid.Row="1" Grid.Column="2"
                                Content="开始"
                                Command="{Binding StartCommand}"
                                Appearance="Primary"
                                IsEnabled="{Binding StartButtonEnabled}"
                                Width="96" Height="38" Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}" />

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                                   Text="请选择你准备用网线连接服务器的那块网卡"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}" />

                        <!-- ── Running state: after flow starts ── -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                                    Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVis}}"
                                    Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="10" Height="10"
                                     Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding AdapterCardLine1}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Current step card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="32,24">
                    <ContentControl Content="{Binding}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Icon -->
                                    <Grid Width="56" Height="56" HorizontalAlignment="Center"
                                          Margin="0,0,0,12">
                                        <Ellipse x:Name="BadgeCircle"
                                                 Width="56" Height="56"
                                                 Fill="Transparent"
                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="3" />
                                        <Path x:Name="BadgeCheck"
                                              Data="M15,28 L25,38 L42,18"
                                              Stroke="White" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <Path x:Name="BadgeCross"
                                              Data="M17,17 L39,39 M39,17 L17,39"
                                              Stroke="White" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                    </Grid>

                                    <TextBlock x:Name="BadgeTitle"
                                               Text="{Binding CurrentStep.Title}"
                                               FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Text="{Binding ActivityText}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,0,0,10" MaxWidth="440"
                                               TextWrapping="Wrap" />

                                    <Border x:Name="BadgeBorder"
                                            CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDisabledBrush}">
                                        <TextBlock x:Name="BadgeTextBlock"
                                                   Text="{Binding BadgeText}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="{Binding CurrentStep.Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,10,0,0" MaxWidth="440"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeCheck" Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="BadgeTitle" Property="Foreground"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Active}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Failed}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeCross" Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="BadgeTitle" Property="Foreground"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <!-- ── Step indicator ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="32,16">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="20" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left connector line -->
                                    <Rectangle x:Name="LeftLine"
                                               Grid.Row="0" Grid.Column="0"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisInv}}" />

                                    <!-- Right connector line -->
                                    <Rectangle x:Name="RightLine"
                                               Grid.Row="0" Grid.Column="2"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsLast, Converter={StaticResource BoolToVisInv}}" />

                                    <!-- Circle + check / cross -->
                                    <Grid Grid.Row="0" Grid.Column="1"
                                          Width="20" Height="20">
                                        <Ellipse x:Name="StepCircle"
                                                 Width="20" Height="20"
                                                 Fill="Transparent"
                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="2" />
                                        <!-- Checkmark -->
                                        <Path x:Name="StepCheck"
                                              Data="M5,10 L8,13 L15,6"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <!-- Cross -->
                                        <Path x:Name="StepCross"
                                              Data="M6,6 L14,14 M14,6 L6,14"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                    </Grid>

                                    <!-- Label -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding ShortTitle}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <!-- ═══ Step DataTriggers ═══ -->
                                <DataTemplate.Triggers>
                                    <!-- Done -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="StepCheck"
                                                Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="RightLine"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <!-- Active -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Active}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                    </DataTrigger>
                                    <!-- Failed -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Failed}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="StepCross"
                                                Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>

                                    <!-- Left line turns green when previous step is Done -->
                                    <DataTrigger Binding="{Binding PreviousState}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="LeftLine"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ Footer ═══════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid Height="56">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" · " FontSize="11"
                               Foreground="{DynamicResource CardStrokeColorDefaultBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock FontSize="11" VerticalAlignment="Center"
                               Cursor="Hand">
                        <Hyperlink NavigateUri="{Binding GitHubUrl}"
                                   RequestNavigate="GitHubLink_RequestNavigate"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   TextDecorations="None">
                            GitHub
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <ui:Button Content="完成 / 退出"
                        Command="{Binding ExitCommand}"
                        Appearance="Success"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="130" Height="40" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
