<Window x:Class="EzGetBmcIp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EzGetBmcIp"
        Title="ezgetBMCIP — BMC 管理口快速登录工具"
        Icon="ezgetBMCIP.ico"
        Width="840" Height="750" MinWidth="760" MinHeight="660"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:StepStateToCircleFillConverter x:Key="CircleFillConv"/>
        <local:StepStateToCircleStrokeConverter x:Key="CircleStrokeConv"/>
        <local:StepStateToCheckVisibilityConverter x:Key="CheckVisConv"/>
        <local:StepStateToCrossVisibilityConverter x:Key="CrossVisConv"/>
        <local:StepStateToLineFillConverter x:Key="LineFillConv"/>
        <local:StepStateToBadgeBrushConverter x:Key="BadgeBrushConv"/>
        <local:StepStateToBadgeTextConverter x:Key="BadgeTextConv"/>
        <local:StepStateToTitleForegroundConverter x:Key="TitleFgConv"/>
        <local:InvertBoolConverter x:Key="InvertBoolConv"/>
        <local:BoolToVisibilityInvertedConverter x:Key="BoolToVisInv"/>
        <local:BadgeForegroundConverter x:Key="BadgeFgConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ Title Bar ═══════════════ -->
        <Grid Grid.Row="0" Background="{StaticResource VsTitleBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="42"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource VsAccentBrush}"/>

            <Image Grid.Column="1" Source="{StaticResource AppIconDrawing}"
                   Width="22" Height="22" VerticalAlignment="Center" Margin="12,0,6,0"/>

            <TextBlock Grid.Column="2" Text="ezgetBMCIP — BMC 管理口快速登录工具"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="13" Foreground="{StaticResource VsTextBrush}"/>

            <Button Grid.Column="3" Content="✕"
                    Width="36" Height="26"
                    Background="Transparent" Foreground="{StaticResource VsMutedBrush}"
                    FontSize="15" BorderThickness="0" Padding="0"
                    Click="CloseButton_Click"/>
        </Grid>

        <!-- ═══════════════ Content ═══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource VsBaseBrush}">
            <StackPanel Margin="8,6,8,0">

                <!-- Hero card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <!-- Glow host: icon + light ring -->
                            <Grid Width="44" Height="44" Margin="0,0,12,0"
                                  VerticalAlignment="Center">
                                <!-- Glow ring -->
                                <Ellipse x:Name="HeroGlow" Width="40" Height="40"
                                         Fill="{StaticResource VsAccentBrush}" Opacity="0.12"/>
                                <!-- Icon -->
                                <Image Source="{StaticResource AppIconDrawing}"
                                       Width="28" Height="28"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform x:Name="HeroScale" ScaleX="1" ScaleY="1"/>
                                    </Image.RenderTransform>
                                </Image>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HeroScale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    From="1.0" To="1.04"
                                                    Duration="0:0:2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HeroScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="1.0" To="1.04"
                                                    Duration="0:0:2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HeroGlow"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0.12" To="0.32"
                                                    Duration="0:0:2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource VsAccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DetailText}" FontSize="14"
                                   Foreground="{StaticResource VsMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Adapter selector card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header always visible -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="目标网卡"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource VsAccentBrush}" Margin="0,0,0,6"/>

                        <!-- ── Default state: before flow starts ── -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="选择网卡"
                                   VerticalAlignment="Center" FontSize="14"
                                   Foreground="{StaticResource VsMutedBrush}" Margin="0,0,14,0"
                                   Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}"/>

                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapterItem}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding AdapterSelectionEnabled}"
                                  Height="38" VerticalAlignment="Center"
                                  Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}"/>

                        <Button Grid.Row="1" Grid.Column="2"
                                Content="开始"
                                Command="{Binding StartCommand}"
                                Background="{StaticResource VsAccentBrush}"
                                IsEnabled="{Binding StartButtonEnabled}"
                                Width="96" Height="38" Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}"/>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                                   Text="请选择你准备用网线连接服务器的那块网卡"
                                   FontSize="12" Foreground="{StaticResource VsMutedBrush}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVisInv}}"/>

                        <!-- ── Running state: after flow starts ── -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                                    Visibility="{Binding IsFlowStarted, Converter={StaticResource BoolToVis}}"
                                    Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource VsSuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding AdapterCardLine1}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource VsTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Current step card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="32,24">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Icon -->
                        <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Ellipse Width="56" Height="56"
                                     Fill="{Binding BadgeState, Converter={StaticResource CircleFillConv}}"
                                     Stroke="{Binding BadgeState, Converter={StaticResource CircleStrokeConv}}"
                                     StrokeThickness="3"/>
                            <!-- Checkmark for Done -->
                            <Path Data="M15,28 L25,38 L42,18"
                                  Stroke="White" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding BadgeState, Converter={StaticResource CheckVisConv}}"/>
                            <!-- Cross for Failed -->
                            <Path Data="M17,17 L39,39 M39,17 L17,39"
                                  Stroke="White" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding BadgeState, Converter={StaticResource CrossVisConv}}"/>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="{Binding CurrentStep.Title}" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"
                                   Foreground="{Binding BadgeState, Converter={StaticResource TitleFgConv}}"/>

                        <!-- Activity -->
                        <TextBlock Text="{Binding ActivityText}" FontSize="12"
                                   Foreground="{StaticResource VsMutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,0,8" MaxWidth="440" TextWrapping="Wrap"/>

                        <!-- Badge -->
                        <Border CornerRadius="3" Padding="12,4" HorizontalAlignment="Center"
                                Background="{Binding BadgeState, Converter={StaticResource BadgeBrushConv}}">
                            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding BadgeState, Converter={StaticResource BadgeFgConv}}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="{Binding CurrentStep.Description}" FontSize="12"
                                   Foreground="{StaticResource VsMutedBrush}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,8,0,0" MaxWidth="440" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Step indicator -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="32,14">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="20"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left connector line -->
                                    <Rectangle Grid.Row="0" Grid.Column="0"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{Binding PreviousState, Converter={StaticResource LineFillConv}}"
                                               Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisInv}}"/>

                                    <!-- Right connector line (hidden for last) -->
                                    <Rectangle Grid.Row="0" Grid.Column="2"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{Binding State, Converter={StaticResource LineFillConv}}"
                                               Visibility="{Binding IsLast, Converter={StaticResource BoolToVisInv}}"/>

                                    <!-- Circle + check / cross -->
                                    <Grid Grid.Row="0" Grid.Column="1" Width="18" Height="18">
                                        <Ellipse Width="18" Height="18"
                                                 Fill="{Binding State, Converter={StaticResource CircleFillConv}}"
                                                 Stroke="{Binding State, Converter={StaticResource CircleStrokeConv}}"
                                                 StrokeThickness="2"/>
                                        <Path Data="M4,9 L7,12 L14,5"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="{Binding State, Converter={StaticResource CheckVisConv}}"/>
                                        <Path Data="M5,5 L13,13 M13,5 L5,13"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="{Binding State, Converter={StaticResource CrossVisConv}}"/>
                                    </Grid>

                                    <!-- Label -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                               Text="{Binding ShortTitle}" FontSize="13"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"
                                               Foreground="{StaticResource VsMutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ Footer ═══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource VsCardBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" FontSize="11"
                               Foreground="{StaticResource VsMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" · " FontSize="11"
                               Foreground="{StaticResource VsBorderBrush}" VerticalAlignment="Center"/>
                    <TextBlock FontSize="11" VerticalAlignment="Center" Cursor="Hand"
                               Foreground="{StaticResource VsAccentBrush}">
                        <Hyperlink NavigateUri="{Binding GitHubUrl}" RequestNavigate="GitHubLink_RequestNavigate"
                                   Foreground="{StaticResource VsAccentBrush}" TextDecorations="None">
                            GitHub
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <Button Content="完成 / 退出"
                        Command="{Binding ExitCommand}"
                        Background="{StaticResource VsExitBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="130" Height="40"
                        FontSize="14" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
