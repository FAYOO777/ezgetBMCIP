<ui:FluentWindow x:Class="EzGetBmcIp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:EzGetBmcIp"
        Title="ezgetBMCIP"
        Width="840" Height="780" MinWidth="760" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Title Bar ═══════════════ -->
        <ui:TitleBar Grid.Row="0"
                     Title="ezgetBMCIP">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource AppIconDrawing}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ═══════════════ Content ═══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,24">

                <!-- ── Preparation card ── -->
                <Grid MinHeight="560"
                      Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=Preparation}">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="28,24"
                            MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding DetailText}" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20" />

                        <TextBlock Text="🔌 准备工作" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="请确保服务器管理口和笔记本已通过网线直连。"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Text="⚠ 注意事项" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap">
                            <Run Text="此工具仅限直连使用，" />
                            <Run Text="无法在局域网内使用" FontWeight="Bold" />
                            <Run Text="。" />
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            工具会临时修改选择的网卡 IP 配置，退出时自动还原为 DHCP。
                        </TextBlock>

                        <ui:Button Content="下一步 →"
                                   Command="{Binding GoNextCommand}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Center"
                                   Width="140" Height="40" />
                    </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Hero card (AdapterSelection + FlowRunning) ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18"
                        Visibility="{Binding IsAdapterVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DetailText}" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ── Adapter selector card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18,16"
                        Visibility="{Binding IsAdapterVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="目标网卡"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Margin="0,0,0,8" />

                        <!-- ── Default state: before flow starts ── -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="选择网卡"
                                   VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,14,0"
                                   Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}" />

                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapterItem}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding AdapterSelectionEnabled}"
                                  Height="38" VerticalAlignment="Center"
                                  Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}" />

                        <ui:Button Grid.Row="1" Grid.Column="2"
                                Content="开始"
                                Command="{Binding StartCommand}"
                                Appearance="Primary"
                                IsEnabled="{Binding StartButtonEnabled}"
                                Width="96" Height="38" Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}" />

                        <!-- ── Running state: after flow starts ── -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                                    Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=FlowRunning}"
                                    Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="10" Height="10"
                                     Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding AdapterCardLine1}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Subnet config card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18,14"
                        Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=AdapterSelection}">
                    <StackPanel>
                        <TextBlock Text="⚙ 自定义网段（可选）" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Margin="0,0,0,10" />

                        <!-- 4 octet input boxes -->
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SubnetConfig.Octet1Text, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="3" TextAlignment="Center"
                                     FontSize="18" FontWeight="SemiBold"
                                     Height="40" VerticalContentAlignment="Center"
                                     Style="{StaticResource SubnetOctetTextBoxStyle}"
                                     PreviewTextInput="OctetTextBox_PreviewTextInput" />
                            <TextBlock Grid.Column="1" Text="." FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding SubnetConfig.Octet2Text, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="3" TextAlignment="Center"
                                     FontSize="18" FontWeight="SemiBold"
                                     Height="40" VerticalContentAlignment="Center"
                                     Style="{StaticResource SubnetOctetTextBoxStyle}"
                                     PreviewTextInput="OctetTextBox_PreviewTextInput" />
                            <TextBlock Grid.Column="3" Text="." FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="4" Text="{Binding SubnetConfig.Octet3Text, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="3" TextAlignment="Center"
                                     FontSize="18" FontWeight="SemiBold"
                                     Height="40" VerticalContentAlignment="Center"
                                     Style="{StaticResource SubnetOctetTextBoxStyle}"
                                     PreviewTextInput="OctetTextBox_PreviewTextInput" />
                            <TextBlock Grid.Column="5" Text="." FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="6" Text="{Binding SubnetConfig.Octet4Text, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="3" TextAlignment="Center"
                                     FontSize="18" FontWeight="SemiBold"
                                     Height="40" VerticalContentAlignment="Center"
                                     Style="{StaticResource SubnetOctetTextBoxStyle}"
                                     PreviewTextInput="OctetTextBox_PreviewTextInput" />
                        </Grid>

                        <!-- Info -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="子网掩码: 255.255.255.0"/>
                            <Run Text="  ·  "/>
                            <Run Text="BMC 固定地址: "/>
                            <Run Text="{Binding SubnetConfig.PoolDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── Current step card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="32,24"
                        Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=FlowRunning}">
                    <ContentControl Content="{Binding}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Icon -->
                                    <Grid Width="56" Height="56" HorizontalAlignment="Center"
                                          Margin="0,0,0,12">
                                        <Ellipse x:Name="BadgeCircle"
                                                 Width="56" Height="56"
                                                 Fill="Transparent"
                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="3" />
                                        <Path x:Name="BadgeCheck"
                                              Data="M15,28 L25,38 L42,18"
                                              Stroke="White" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <Path x:Name="BadgeCross"
                                              Data="M17,17 L39,39 M39,17 L17,39"
                                              Stroke="White" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                    </Grid>

                                    <TextBlock x:Name="BadgeTitle"
                                               Text="{Binding CurrentStep.Title}"
                                               FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Text="{Binding ActivityText}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,0,0,10" MaxWidth="440"
                                               TextWrapping="Wrap" />

                                    <Border x:Name="BadgeBorder"
                                            CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDisabledBrush}">
                                        <TextBlock x:Name="BadgeTextBlock"
                                                   Text="{Binding BadgeText}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="{Binding CurrentStep.Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,10,0,0" MaxWidth="440"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeCheck" Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="BadgeTitle" Property="Foreground"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Active}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BadgeState}"
                                                 Value="{x:Static local:StepState.Failed}">
                                        <Setter TargetName="BadgeCircle" Property="Fill"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="BadgeCircle" Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="BadgeCross" Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="BadgeTitle" Property="Foreground"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="BadgeBorder" Property="Background"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="BadgeTextBlock" Property="Foreground"
                                                Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <!-- ── IP result card ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="28,20"
                        Visibility="{Binding IsIpCardVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎯 已获取 BMC 地址" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />

                        <!-- Large IP -->
                        <TextBlock Text="{Binding DiscoveredIp}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas, Courier New"
                                   Margin="0,0,0,8" />

                        <!-- Copy + Open buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="{Binding CopyButtonText}"
                                       Command="{Binding CopyIpCommand}"
                                       Appearance="Secondary"
                                       Width="100" Height="36" Margin="0,0,10,0" />
                            <ui:Button Content="打开 BMC →"
                                       Appearance="Success"
                                       Width="110" Height="36"
                                       Click="OpenBmcButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Step indicator ── -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="32,16"
                        Visibility="{Binding AppPhase, Converter={StaticResource PhaseToVis}, ConverterParameter=FlowRunning}">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="20" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left connector line -->
                                    <Rectangle x:Name="LeftLine"
                                               Grid.Row="0" Grid.Column="0"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisInv}}" />

                                    <!-- Right connector line -->
                                    <Rectangle x:Name="RightLine"
                                               Grid.Row="0" Grid.Column="2"
                                               Height="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                               Visibility="{Binding IsLast, Converter={StaticResource BoolToVisInv}}" />

                                    <!-- Circle + check / cross -->
                                    <Grid Grid.Row="0" Grid.Column="1"
                                          Width="20" Height="20">
                                        <Ellipse x:Name="StepCircle"
                                                 Width="20" Height="20"
                                                 Fill="Transparent"
                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="2" />
                                        <!-- Checkmark -->
                                        <Path x:Name="StepCheck"
                                              Data="M5,10 L8,13 L15,6"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <!-- Cross -->
                                        <Path x:Name="StepCross"
                                              Data="M6,6 L14,14 M14,6 L6,14"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                    </Grid>

                                    <!-- Label -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding ShortTitle}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <!-- ═══ Step DataTriggers ═══ -->
                                <DataTemplate.Triggers>
                                    <!-- Done -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="StepCheck"
                                                Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="RightLine"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <!-- Active -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Active}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                    </DataTrigger>
                                    <!-- Failed -->
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:StepState.Failed}">
                                        <Setter TargetName="StepCircle"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="StepCircle"
                                                Property="Stroke"
                                                Value="Transparent" />
                                        <Setter TargetName="StepCross"
                                                Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>

                                    <!-- Left line turns green when previous step is Done -->
                                    <DataTrigger Binding="{Binding PreviousState}"
                                                 Value="{x:Static local:StepState.Done}">
                                        <Setter TargetName="LeftLine"
                                                Property="Fill"
                                                Value="{StaticResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ Footer ═══════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid Height="56">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" · " FontSize="11"
                               Foreground="{DynamicResource CardStrokeColorDefaultBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock FontSize="11" VerticalAlignment="Center"
                               Cursor="Hand">
                        <Hyperlink NavigateUri="{Binding GitHubUrl}"
                                   RequestNavigate="GitHubLink_RequestNavigate"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   TextDecorations="None">
                            GitHub
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <ui:Button Content="完成 / 退出"
                        Command="{Binding ExitCommand}"
                        Appearance="Secondary"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="130" Height="40" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
