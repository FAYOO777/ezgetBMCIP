<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ezgetBMCIP.ico</ApplicationIcon>
    <AssemblyName>ezgetBMCIP</AssemblyName>
    <RootNamespace>EzGetBmcIp</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="ezgetBMCIP.ico" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="artifacts\**" />
    <Compile Remove="publish-vscode\**" />
  </ItemGroup>
</Project>
