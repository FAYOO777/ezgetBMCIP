<Application x:Class="EzGetBmcIp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:EzGetBmcIp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI theme & control styles -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ App icon (vector) ═══ -->
            <DrawingImage x:Key="AppIconDrawing">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing
                            Geometry="M340.091,90.3362 C354.765,90.3362 366.661,102.232 366.661,116.906 C366.661,131.58 354.765,143.476 340.091,143.476 L148.789,143.476 C134.114,143.476 122.219,131.58 122.219,116.906 C122.219,102.232 134.114,90.3362 148.789,90.3362 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#007ACC" Offset="0"/>
                                    <GradientStop Color="#2EA043" Offset="1"/>
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#007ACC"
                            Geometry="M116.907,233.814 C181.473,233.814 233.814,181.473 233.814,116.907 C233.814,52.341 181.473,0 116.907,0 C52.341,0 0,52.341 0,116.907 C0,181.473 52.341,233.814 116.907,233.814 Z"/>
                        <GeometryDrawing
                            Geometry="M116.907,175.36 C149.19,175.36 175.36,149.19 175.36,116.907 C175.36,84.6236 149.19,58.4531 116.907,58.4531 C84.6236,58.4531 58.4531,84.6236 58.4531,116.907 C58.4531,149.19 84.6236,175.36 116.907,175.36 Z">
                            <GeometryDrawing.Brush>
                                <SolidColorBrush Color="White" Opacity="0.35"/>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#2EA043"
                            Geometry="M371.976,201.93 C418.933,201.93 457,163.863 457,116.906 C457,69.9493 418.933,31.8831 371.976,31.8831 C325.019,31.8831 286.953,69.9493 286.953,116.906 C286.953,163.863 325.019,201.93 371.976,201.93 Z"/>
                        <GeometryDrawing
                            Geometry="M371.977,157.292 C394.281,157.292 412.363,139.211 412.363,116.906 C412.363,94.6015 394.281,76.52 371.977,76.52 C349.672,76.52 331.591,94.6015 331.591,116.906 C331.591,139.211 349.672,157.292 371.977,157.292 Z">
                            <GeometryDrawing.Brush>
                                <SolidColorBrush Color="White" Opacity="0.42"/>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ═══ Generic converters ═══ -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:InvertBoolConverter x:Key="InvertBoolConv" />
            <local:BoolToVisibilityInvertedConverter x:Key="BoolToVisInv" />
            <local:AppPhaseToVisibilityConverter x:Key="PhaseToVis" />

            <!-- ═══ Brand colors: stable across Windows accent themes ═══ -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#007ACC" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#1688D8" />
            <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#006BB3" />
            <SolidColorBrush x:Key="BrandPrimaryDisabledBrush" Color="#6D93AD" />
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#3B8F5A" />
            <SolidColorBrush x:Key="BrandCriticalBrush" Color="#B94A48" />
            <SolidColorBrush x:Key="BrandMutedTextBrush" Color="#9AA7B8" />

            <!-- ═══ Subnet octet TextBox style ═══ -->
            <Style x:Key="SubnetOctetTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- ═══ Brand primary button: independent from Windows accent color ═══ -->
            <Style x:Key="BrandPrimaryButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:Button}">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BrandPrimaryHoverBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandPrimaryHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BrandPrimaryPressedBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandPrimaryPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BrandPrimaryDisabledBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandPrimaryDisabledBrush}" />
                                    <Setter Property="Foreground" Value="#D8DEE8" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Card style (uses WPF-UI theme brushes) ═══ -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="24,18" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
